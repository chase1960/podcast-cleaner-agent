# ── LLM（OpenAI 兼容接口）──────────────────────────────
PODCLEANER_LLM_BASE_URL=https://api.openai.com/v1
PODCLEANER_LLM_API_KEY=
PODCLEANER_LLM_MODEL=gpt-4o-mini

# ── 存储 ───────────────────────────────────────────────
# wiki: 飞书知识库；local: 本地 Markdown 目录
PODCLEANER_STORE=wiki
PODCLEANER_INDEX_FILE=.podcleaner/index.json

# ── 飞书 Wiki（store=wiki 时必填）──────────────────────
PODCLEANER_WIKI_SPACE_ID=
# 知识库首页完整链接（卡片入口跳转用，可选）
PODCLEANER_WIKI_HOME_URL=
# 根节点 token（可选；分类目录会建在空间根目录，通常无需填写）
PODCLEANER_WIKI_ROOT_NODE=
# 飞书 CLI 可执行文件；已加入 PATH 时保持 lark-cli 即可
PODCLEANER_LARK_CLI=lark-cli

# ── 抓取 ──────────────────────────────────────────────
PODCLEANER_HTTP_TIMEOUT=15
# 手动稿回退文件（可选）：取不到公开内容时从该文件读取粘贴稿
PODCLEANER_MANUAL_TRANSCRIPT=

# ── ASR（可选，仅音频转写回退时需要）────────────────────
PODCLEANER_ASR_ENGINE=none   # none | whisper

# ── 个人沉淀层（啊哈时刻 / 待解问题 / 深耕方向）──────────
# 单条笔记内各类结构的保留上限
PODCLEANER_MAX_AHA=3
PODCLEANER_MAX_OPEN_QUESTIONS=3
PODCLEANER_MAX_NEXT_STEPS=3
# 是否在简报里生成跨条目主题脉络（知识线索）
PODCLEANER_ENABLE_THREADS=true
